<Window x:Class="nexIRC.Desktop.ParticipantInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Participant action"
        SizeToContent="WidthAndHeight"
        Width="430"
        MinWidth="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="18">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBox x:Name="ValueBox" MinHeight="28" Padding="6,4" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="16,5" Margin="0,0,8,0" />
            <Button Content="OK" IsDefault="True" Padding="18,5" Click="OnOkClick" />
        </StackPanel>
    </StackPanel>
</Window>
