<Window x:Class="nexIRC.Desktop.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IRC History and Search" Width="900" Height="620"
        MinWidth="700" MinHeight="480" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <WrapPanel>
                <TextBox x:Name="QueryBox" Width="250" Margin="0,0,8,8" ToolTip="Text to search" />
                <ComboBox x:Name="NetworkBox" Width="180" Margin="0,0,8,8" DisplayMemberPath="DisplayName" />
                <TextBox x:Name="ConversationBox" Width="180" Margin="0,0,8,8" ToolTip="Optional channel or nickname" />
                <Button Content="Search" Click="OnSearchClick" Padding="14,4" Margin="0,0,8,8" />
                <Button Content="Load history" Click="OnHistoryClick" Padding="14,4" Margin="0,0,8,8" />
            </WrapPanel>
            <TextBlock x:Name="StatusText" Foreground="#64748B" Margin="0,0,0,8" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Open selected conversation" Click="OnOpenClick" Padding="14,6" Margin="0,0,8,0" />
            <Button Content="Close" IsCancel="True" Padding="14,6" />
        </StackPanel>
        <ListBox x:Name="ResultsList" DisplayMemberPath="DisplayText" />
    </DockPanel>
</Window>
