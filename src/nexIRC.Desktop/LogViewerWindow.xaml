<Window x:Class="nexIRC.Desktop.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IRC History and Search" Width="900" Height="620"
        MinWidth="700" MinHeight="480" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <WrapPanel>
                <TextBox x:Name="QueryBox" Width="250" Margin="0,0,8,8" ToolTip="Text to search" />
                <ComboBox x:Name="ScopeBox" Width="170" Margin="0,0,8,8" DisplayMemberPath="DisplayName" ToolTip="Search scope" />
                <ComboBox x:Name="NetworkBox" Width="180" Margin="0,0,8,8" DisplayMemberPath="DisplayName" ToolTip="Optional network filter" />
                <TextBox x:Name="ConversationBox" Width="180" Margin="0,0,8,8" ToolTip="Optional channel or nickname" />
                <ComboBox x:Name="ConversationKindBox" Width="145" Margin="0,0,8,8" DisplayMemberPath="DisplayName" ToolTip="Optional conversation kind" />
                <TextBox x:Name="SenderBox" Width="130" Margin="0,0,8,8" ToolTip="Optional sender/nick" />
                <ComboBox x:Name="MessageKindBox" Width="125" Margin="0,0,8,8" DisplayMemberPath="DisplayName" ToolTip="Optional event kind" />
                <Button Content="Search" Click="OnSearchClick" Padding="14,4" Margin="0,0,8,8" />
                <Button x:Name="CancelSearchButton" Content="Cancel" Click="OnCancelSearchClick" Padding="14,4" Margin="0,0,8,8" IsEnabled="False" />
            </WrapPanel>
            <WrapPanel>
                <TextBox x:Name="FromDateBox" Width="170" Margin="0,0,8,8" ToolTip="Optional from date/time" />
                <TextBox x:Name="ToDateBox" Width="170" Margin="0,0,8,8" ToolTip="Optional to date/time" />
                <Button Content="Newest" Click="OnNewestClick" Padding="14,4" Margin="0,0,8,8" />
                <Button Content="Oldest" Click="OnOldestClick" Padding="14,4" Margin="0,0,8,8" />
                <Button Content="Older" Click="OnOlderClick" Padding="14,4" Margin="0,0,8,8" />
                <Button Content="Newer" Click="OnNewerClick" Padding="14,4" Margin="0,0,8,8" />
                <TextBox x:Name="JumpDateBox" Width="170" Margin="0,0,8,8" ToolTip="Local date/time, for example 2026-08-30 14:30" />
                <Button Content="Jump to date" Click="OnJumpDateClick" Padding="14,4" Margin="0,0,8,8" />
                <Button Content="Load history" Click="OnHistoryClick" Padding="14,4" Margin="0,0,8,8" />
            </WrapPanel>
            <TextBlock x:Name="StatusText" Foreground="#64748B" Margin="0,0,0,8" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Previous result" Click="OnPreviousResultClick" Padding="14,6" Margin="0,0,8,0" />
            <Button Content="Next result" Click="OnNextResultClick" Padding="14,6" Margin="0,0,8,0" />
            <Button Content="Open selected conversation" Click="OnOpenClick" Padding="14,6" Margin="0,0,8,0" />
            <Button Content="Export…" Click="OnExportClick" Padding="14,6" Margin="0,0,8,0" />
            <Button Content="Copy selected" Click="OnCopyClick" Padding="14,6" Margin="0,0,8,0" />
            <Button Content="Close" IsCancel="True" Padding="14,6" />
        </StackPanel>
        <ListBox x:Name="ResultsList" DisplayMemberPath="DisplayText" />
    </DockPanel>
</Window>
