<Window x:Class="nexIRC.Desktop.AliasesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aliases and Custom Commands" Width="780" Height="500"
        MinWidth="650" MinHeight="420" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="New" Click="OnNewClick" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="Save" Click="OnSaveClick" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="Enable/disable" Click="OnToggleClick" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="Delete" Click="OnDeleteClick" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="Close" IsCancel="True" Padding="12,6" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ListBox x:Name="AliasesList" DisplayMemberPath="Name" SelectionChanged="OnSelectionChanged" />
            <StackPanel Grid.Column="2">
                <TextBlock Text="Alias name" Foreground="#475569" />
                <TextBox x:Name="NameBox" Margin="0,3,0,10" />
                <TextBlock Text="Expansion (use $1, $2, or $* for arguments)" Foreground="#475569" />
                <TextBox x:Name="ExpansionBox" Margin="0,3,0,10" />
                <TextBlock Text="Description" Foreground="#475569" />
                <TextBox x:Name="DescriptionBox" Margin="0,3,0,10" />
                <TextBlock Text="Example: /j #chat expands to /join #chat. Built-in names remain authoritative." Foreground="#64748B" TextWrapping="Wrap" />
                <TextBlock x:Name="StatusText" Foreground="#B91C1C" Margin="0,12,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
