<Window x:Class="nexIRC.Desktop.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preferences"
        Width="520"
        Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="16,6" Margin="0,0,8,0" />
            <Button Content="Save" IsDefault="True" Click="OnSaveClick" Padding="16,6" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Preferences" FontSize="22" FontWeight="SemiBold" Foreground="#172033" Margin="0,0,0,14" />
                <GroupBox Header="Highlights" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox x:Name="HighlightNicknameBox" Content="Highlight my nickname" Margin="0,2,0,7" />
                        <CheckBox x:Name="HighlightCustomWordsBox" Content="Highlight custom words" Margin="0,0,0,7" />
                        <TextBlock Text="Custom words (one per line or comma separated)" Foreground="#475569" />
                        <TextBox x:Name="CustomWordsBox" Height="58" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Notifications" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox x:Name="NotificationsBox" Content="Enable desktop notifications" Margin="0,2,0,7" />
                        <CheckBox x:Name="HighlightNotificationsBox" Content="Notify for nickname/custom-word highlights" Margin="0,0,0,7" />
                        <CheckBox x:Name="PrivateMessageNotificationsBox" Content="Notify for private messages" Margin="0,0,0,7" />
                        <CheckBox x:Name="ConnectionNotificationsBox" Content="Notify when a connection fails" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Conversation history" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox x:Name="ConversationLoggingBox" Content="Enable persistent conversation logging" Margin="0,2,0,7" />
                        <CheckBox x:Name="PrivateLoggingBox" Content="Log private conversations" Margin="0,0,0,7" />
                        <CheckBox x:Name="StatusLoggingBox" Content="Log network/status messages" Margin="0,0,0,7" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Retention days" VerticalAlignment="Center" />
                            <TextBox x:Name="RetentionDaysBox" Width="70" Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
                <TextBlock Text="Notifications use an optional Windows taskbar balloon adapter. They never store credentials." Foreground="#64748B" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
