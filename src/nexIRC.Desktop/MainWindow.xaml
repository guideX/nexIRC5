<Window x:Class="nexIRC.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:nexIRC.Application;assembly=nexIRC.Application"
        xmlns:local="clr-namespace:nexIRC.Desktop"
        Title="nexIRC 5"
        AutomationProperties.AutomationId="MainWindow"
        Width="1280"
        Height="780"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8"
        Closing="OnClosing" Loaded="OnLoaded">
    <Window.InputBindings>
        <KeyBinding Key="Tab" Modifiers="Control" Command="{Binding NextConversationCommand}" />
        <KeyBinding Key="Tab" Modifiers="Control+Shift" Command="{Binding PreviousConversationCommand}" />
        <KeyBinding Key="PageDown" Modifiers="Control+Alt" Command="{Binding NextUnreadCommand}" />
        <KeyBinding Key="PageUp" Modifiers="Control+Alt" Command="{Binding PreviousUnreadCommand}" />
        <KeyBinding Key="PageDown" Modifiers="Control+Alt+Shift" Command="{Binding NextHighlightCommand}" />
        <KeyBinding Key="PageUp" Modifiers="Control+Alt+Shift" Command="{Binding PreviousHighlightCommand}" />
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding BackConversationCommand}" />
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding ForwardConversationCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <Style x:Key="PaneHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Margin" Value="10,8,10,6" />
        </Style>
        <DataTemplate x:Key="TranscriptEntryTemplate">
            <DockPanel LastChildFill="True" Margin="2,1">
                <TextBlock DockPanel.Dock="Left" Text="{Binding DisplayTime}" Width="62" Foreground="#94A3B8" />
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasReplyRelationship, Converter={StaticResource BooleanToVisibility}}">
                        <Button Content="{Binding ReplyIndicatorText}" Tag="{Binding}" Click="OnReplyParentClick" Padding="2,0" Margin="0,0,6,0" BorderThickness="0" Background="Transparent" Foreground="#2563EB" ToolTip="Navigate to the referenced parent message" AutomationProperties.AutomationId="MessageReply.Parent" />
                        <Button Content="Show original" Tag="{Binding}" Click="OnReplyParentClick" Padding="2,0" BorderThickness="0" Background="Transparent" Foreground="#64748B" Visibility="{Binding CanRecoverReplyParent, Converter={StaticResource BooleanToVisibility}}" AutomationProperties.AutomationId="MessageReply.ShowOriginal" />
                    </StackPanel>
                    <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#1E293B" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                        <Setter Property="Foreground" Value="#2563EB" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static app:TranscriptEntryKind.OutgoingAction}">
                                        <Setter Property="Foreground" Value="#7C3AED" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static app:TranscriptEntryKind.Error}">
                                        <Setter Property="Foreground" Value="#B91C1C" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsHighlight}" Value="True">
                                        <Setter Property="Background" Value="#FEF3C7" />
                                        <Setter Property="Foreground" Value="#92400E" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsNavigationAnchor}" Value="True">
                                        <Setter Property="Background" Value="#DBEAFE" />
                                        <Setter Property="Foreground" Value="#1D4ED8" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static app:TranscriptEntryKind.Capability}">
                                        <Setter Property="Foreground" Value="#047857" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static app:TranscriptEntryKind.Authentication}">
                                        <Setter Property="Foreground" Value="#7C3AED" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static app:TranscriptEntryKind.Reconnect}">
                                        <Setter Property="Foreground" Value="#B45309" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding ReactionSummary}"
                                  Visibility="{Binding HasReactions, Converter={StaticResource BooleanToVisibility}}"
                                  AutomationProperties.AutomationId="MessageReaction.Summary"
                                  AutomationProperties.Name="{Binding ReactionAccessibleDescription}"
                                  Margin="0,2,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding DisplayText}"
                                        Tag="{Binding}"
                                        Click="OnReactionToggleClick"
                                        Padding="5,1"
                                        Margin="0,0,4,0"
                                        BorderThickness="0"
                                        Background="#E2E8F0"
                                        Foreground="#334155"
                                        ToolTip="{Binding AccessibleText}"
                                        AutomationProperties.AutomationId="MessageReaction.Toggle"
                                        AutomationProperties.Name="{Binding AccessibleText}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="HistoryContextEntryTemplate">
            <DockPanel Margin="2,1">
                <TextBlock DockPanel.Dock="Left" Text="{Binding DisplayTime}" Width="62" Foreground="#94A3B8" />
                <TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#475569" />
                            <Setter Property="FontStyle" Value="Italic" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                    <Setter Property="Background" Value="#FEF3C7" />
                                    <Setter Property="Foreground" Value="#92400E" />
                                    <Setter Property="FontStyle" Value="Normal" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type app:ServerStatusView}">
            <TextBlock Text="{Binding DisplayLabel}" Margin="4,2" ToolTip="{Binding StateText}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type app:ChannelView}">
            <TextBlock Margin="4,2" ToolTip="{Binding LifecycleText}">
                <Run Text="{Binding StateMarker, Mode=OneWay}" />
                <Run Text=" " />
                <Run Text="{Binding DisplayLabel, Mode=OneWay}" />
            </TextBlock>
        </DataTemplate>
        <DataTemplate DataType="{x:Type app:QueryView}">
            <TextBlock Margin="4,2" ToolTip="{Binding LifecycleText}">
                <Run Text="{Binding StateMarker, Mode=OneWay}" />
                <Run Text=" " />
                <Run Text="{Binding DisplayLabel, Mode=OneWay}" />
            </TextBlock>
        </DataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type app:NetworkWorkspace}" ItemsSource="{Binding Views}">
            <TextBlock Text="{Binding DisplayLabel}" Margin="4,2" FontWeight="SemiBold" />
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type app:ServerStatusView}" x:Key="StatusContentTemplate">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Server status" FontSize="20" FontWeight="SemiBold" Foreground="#172033" />
                    <TextBlock Text="{Binding EndpointText}" Foreground="#64748B" Margin="0,4,0,10" />
                    <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" Foreground="#2563EB" />
                    <TextBlock Text="IRCv3 capabilities" FontWeight="SemiBold" Margin="0,10,0,2" />
                    <TextBlock Text="{Binding CapabilitiesText}" Foreground="#475569" />
                </StackPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding Entries}" ItemTemplate="{StaticResource TranscriptEntryTemplate}" Margin="0,14,0,0" BorderThickness="0" Background="Transparent" FontFamily="Cascadia Mono" />
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type app:ChannelView}" x:Key="ChannelContentTemplate">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="#E2E8F0" CornerRadius="4" Padding="10,7" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock FontSize="19" FontWeight="SemiBold" Foreground="#172033">
                            <Run Text="{Binding StateMarker, Mode=OneWay}" />
                            <Run Text=" " />
                            <Run Text="{Binding Channel, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding TopicText}" Foreground="#475569" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding LifecycleText, StringFormat=Conversation: {0}}" Foreground="#64748B" FontSize="11" />
                        <TextBlock Text="{Binding SynchronizationText, StringFormat=Sync: {0}}" Foreground="#64748B" FontSize="11" />
                    </StackPanel>
                </Border>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                        <ListBox ItemsSource="{Binding Entries}" ItemTemplate="{StaticResource TranscriptEntryTemplate}" BorderThickness="0" Background="White" FontFamily="Cascadia Mono" PreviewMouseWheel="OnConversationPreviewMouseWheel" PreviewKeyDown="OnConversationPreviewKeyDown" ScrollViewer.ScrollChanged="OnConversationScrollChanged" />
                        <Expander Grid.Row="1" Header="Historical context" IsExpanded="True" Visibility="{Binding HasHistoryContext, Converter={StaticResource BooleanToVisibility}}" Margin="0,8,0,0">
                            <DockPanel MaxHeight="220">
                                <TextBlock DockPanel.Dock="Top" Text="{Binding HistoryContextMatch, StringFormat=Match: {0}}" Foreground="#92400E" Margin="6,4" />
                                <ListBox ItemsSource="{Binding HistoryContext}" ItemTemplate="{StaticResource HistoryContextEntryTemplate}" BorderThickness="0" FontFamily="Cascadia Mono" />
                            </DockPanel>
                        </Expander>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="{Binding OlderHistoryStatus}" Click="OnLoadOlderMessagesClick" Padding="10,3" Margin="0,0,6,0" AutomationProperties.AutomationId="LoadOlderMessages" />
                            <Button Content="{Binding NewerHistoryStatus}" Click="OnLoadNewerMessagesClick" Padding="10,3" Margin="0,0,6,0" AutomationProperties.AutomationId="LoadNewerMessages" />
                            <Button Content="Return to latest" Click="OnReturnToLatestClick" Padding="10,3" AutomationProperties.AutomationId="ReturnToLatest" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Column="1" Width="205" Margin="10,0,0,0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Visibility="{Binding DataContext.IsMemberListVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Members" Style="{StaticResource PaneHeader}" />
                    <ListBox AutomationProperties.AutomationId="MemberList" AutomationProperties.Name="Channel members" ItemsSource="{Binding Members}" BorderThickness="0" Padding="8,0" MouseDoubleClick="OnMemberListDoubleClick" ToolTip="Double-click to open a private conversation. Right-click for participant actions.">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" ToolTip="{Binding DetailsText}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type app:QueryView}" x:Key="QueryContentTemplate">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,8">
                    <TextBlock FontSize="19" FontWeight="SemiBold" Foreground="#172033">
                        <Run Text="{Binding StateMarker, Mode=OneWay}" />
                        <Run Text=" " />
                        <Run Text="{Binding Nickname, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding LifecycleText, StringFormat=Private conversation · {0}}" Foreground="#64748B" />
                </StackPanel>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                    <ListBox ItemsSource="{Binding Entries}" ItemTemplate="{StaticResource TranscriptEntryTemplate}" BorderThickness="0" Background="White" FontFamily="Cascadia Mono" PreviewMouseWheel="OnConversationPreviewMouseWheel" PreviewKeyDown="OnConversationPreviewKeyDown" ScrollViewer.ScrollChanged="OnConversationScrollChanged" />
                    <Expander Grid.Row="1" Header="Historical context" IsExpanded="True" Visibility="{Binding HasHistoryContext, Converter={StaticResource BooleanToVisibility}}" Margin="0,8,0,0">
                        <DockPanel MaxHeight="220">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding HistoryContextMatch, StringFormat=Match: {0}}" Foreground="#92400E" Margin="6,4" />
                            <ListBox ItemsSource="{Binding HistoryContext}" ItemTemplate="{StaticResource HistoryContextEntryTemplate}" BorderThickness="0" FontFamily="Cascadia Mono" />
                        </DockPanel>
                    </Expander>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{Binding OlderHistoryStatus}" Click="OnLoadOlderMessagesClick" Padding="10,3" Margin="0,0,6,0" AutomationProperties.AutomationId="LoadOlderMessages" />
                        <Button Content="{Binding NewerHistoryStatus}" Click="OnLoadNewerMessagesClick" Padding="10,3" Margin="0,0,6,0" AutomationProperties.AutomationId="LoadNewerMessages" />
                        <Button Content="Return to latest" Click="OnReturnToLatestClick" Padding="10,3" AutomationProperties.AutomationId="ReturnToLatest" />
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type app:WhoisView}" x:Key="WhoisContentTemplate">
            <ScrollViewer Margin="12" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding Result.Nickname}" FontSize="20" FontWeight="SemiBold" Foreground="#172033" />
                    <TextBlock Text="{Binding StateText}" Foreground="#2563EB" Margin="0,3,0,12" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Open Query" Click="OnWhoisOpenQueryClick" Padding="12,4" Margin="0,0,6,0" AutomationProperties.AutomationId="Whois.OpenQuery" />
                        <Button Content="Copy Nickname" Click="OnWhoisCopyNicknameClick" Padding="12,4" Margin="0,0,6,0" AutomationProperties.AutomationId="Whois.CopyNickname" />
                        <Button Content="Copy Hostmask" Click="OnWhoisCopyHostmaskClick" Padding="12,4" Margin="0,0,6,0" AutomationProperties.AutomationId="Whois.CopyHostmask" />
                        <Button Content="Copy Account" Click="OnWhoisCopyAccountClick" Padding="12,4" Margin="0,0,6,0" AutomationProperties.AutomationId="Whois.CopyAccount" />
                        <Button Content="Copy Formatted" Click="OnWhoisCopyFormattedClick" Padding="12,4" AutomationProperties.AutomationId="Whois.CopyFormatted" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="145" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Username" FontWeight="SemiBold" Margin="0,3" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Result.Username}" Margin="0,3" />
                        <TextBlock Grid.Row="1" Text="Hostname" FontWeight="SemiBold" Margin="0,3" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Result.Hostname}" Margin="0,3" />
                        <TextBlock Grid.Row="2" Text="Real name" FontWeight="SemiBold" Margin="0,3" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Result.RealName}" Margin="0,3" />
                        <TextBlock Grid.Row="3" Text="Server" FontWeight="SemiBold" Margin="0,3" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Result.ServerText}" Margin="0,3" />
                        <TextBlock Grid.Row="4" Text="Account" FontWeight="SemiBold" Margin="0,3" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Result.Account}" Margin="0,3" />
                        <TextBlock Grid.Row="5" Text="Operator" FontWeight="SemiBold" Margin="0,3" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Result.OperatorStatus}" Margin="0,3" />
                        <TextBlock Grid.Row="6" Text="Idle" FontWeight="SemiBold" Margin="0,3" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Result.IdleText}" Margin="0,3" />
                        <TextBlock Grid.Row="7" Text="Sign-on" FontWeight="SemiBold" Margin="0,3" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Result.SignOnText}" Margin="0,3" />
                        <TextBlock Grid.Row="8" Text="Secure/TLS" FontWeight="SemiBold" Margin="0,3" />
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Result.IsSecure, StringFormat={}{0}}" Margin="0,3" />
                    </Grid>
                    <TextBlock Text="Channels" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <ItemsControl ItemsSource="{Binding Result.Channels}" />
                    <TextBlock Text="Away" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <TextBlock Text="{Binding Result.AwayMessage}" TextWrapping="Wrap" />
                    <TextBlock Text="Additional server information" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <ItemsControl ItemsSource="{Binding Result.AdditionalFields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="{x:Type app:ChannelListView}" x:Key="ChannelListContentTemplate">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Channel list" FontSize="20" FontWeight="SemiBold" Foreground="#172033" />
                    <TextBlock Text="{Binding StateText}" Foreground="#2563EB" Margin="0,3,0,0" />
                    <TextBlock Text="Double-click a channel to prepare a join." Foreground="#64748B" FontSize="11" Margin="0,3,0,0" />
                </StackPanel>
                <ListView Grid.Row="1" ItemsSource="{Binding Result.Rows}" MouseDoubleClick="OnChannelListDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Channel" DisplayMemberBinding="{Binding Channel}" Width="180" />
                            <GridViewColumn Header="Users" DisplayMemberBinding="{Binding UsersText}" Width="80" />
                            <GridViewColumn Header="Topic" DisplayMemberBinding="{Binding TopicText}" Width="600" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type app:BanListView}" x:Key="BanListContentTemplate">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="{Binding Channel, StringFormat=Ban List · {0}}" FontSize="20" FontWeight="SemiBold" Foreground="#172033" />
                    <TextBlock Text="{Binding StateText}" Foreground="#2563EB" Margin="0,3,0,8" AutomationProperties.AutomationId="BanList.State" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Refresh" Click="OnBanListRefreshClick" Padding="12,4" Margin="0,0,6,0" AutomationProperties.AutomationId="BanList.Refresh" />
                        <TextBox Text="{Binding Result.NewMask, UpdateSourceTrigger=PropertyChanged}" Width="260" VerticalContentAlignment="Center" ToolTip="Enter an exact ban mask." AutomationProperties.AutomationId="BanList.MaskInput" />
                        <Button Content="Add ban" Click="OnBanListAddClick" Padding="12,4" Margin="6,0,6,0" AutomationProperties.AutomationId="BanList.Add" />
                        <Button Content="Copy mask" Click="OnBanListCopyClick" Padding="12,4" Margin="0,0,6,0" AutomationProperties.AutomationId="BanList.Copy" />
                        <Button Content="Remove selected" Click="OnBanListRemoveClick" Padding="12,4" AutomationProperties.AutomationId="BanList.Remove" />
                    </StackPanel>
                    <TextBox Text="{Binding Result.FilterText, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" Width="260" HorizontalAlignment="Left" ToolTip="Filter masks." AutomationProperties.AutomationId="BanList.Filter" />
                </StackPanel>
                <ListView Grid.Row="1" ItemsSource="{Binding Result.VisibleEntries}" SelectedItem="{Binding Result.SelectedEntry, Mode=TwoWay}" AutomationProperties.AutomationId="BanList.Entries" AutomationProperties.Name="Ban list entries">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Mask" DisplayMemberBinding="{Binding Mask}" Width="340" />
                            <GridViewColumn Header="Set by" DisplayMemberBinding="{Binding SetByText}" Width="180" />
                            <GridViewColumn Header="Set time" DisplayMemberBinding="{Binding SetAtText}" Width="180" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </DataTemplate>
        <local:WorkspaceContentTemplateSelector x:Key="WorkspaceContentSelector" />
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" IsMainMenu="True">
            <MenuItem Header="_File">
                <MenuItem Header="_New Connection…" Command="{Binding NewConnectionCommand}" />
                <MenuItem Header="Saved _Network Profiles…" Click="OnProfilesClick" />
                <Separator />
                <MenuItem Header="_Disconnect" Command="{Binding DisconnectCommand}" />
                <MenuItem Header="_Reconnect" Command="{Binding ReconnectCommand}" />
                <MenuItem Header="Favorites and recents…" Click="OnFavoritesClick" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Network Tree" IsCheckable="True" IsChecked="{Binding IsNetworkTreeVisible, Mode=TwoWay}" />
                <MenuItem Header="Member List" IsCheckable="True" IsChecked="{Binding IsMemberListVisible, Mode=TwoWay}" />
                <MenuItem Header="Toolbar" IsCheckable="True" IsChecked="{Binding IsToolbarVisible, Mode=TwoWay}" />
                <MenuItem Header="Status Bar" IsCheckable="True" IsChecked="{Binding IsStatusBarVisible, Mode=TwoWay}" />
                <Separator />
                <MenuItem Header="Server Status" Click="OnServerStatusClick" />
            </MenuItem>
            <MenuItem Header="_IRC / Server">
                <MenuItem Header="_Join Channel" Command="{Binding JoinCommand}" />
                <MenuItem Header="_Part Channel" Command="{Binding PartCommand}" />
                <MenuItem Header="_Rejoin Channel" Click="OnRejoinClick" />
                <MenuItem Header="_Clear Conversation Display" Click="OnClearClick" />
                <MenuItem Header="_Close View" Click="OnCloseViewClick" />
                <MenuItem Header="Change _Nickname" Click="OnNicknameClick" />
                <MenuItem Header="_WHOIS" Click="OnWhoisClick" />
                <MenuItem Header="Channel _List" Click="OnListClick" />
                <MenuItem Header="_Raw Command" Click="OnRawCommandClick" ToolTip="Type /raw in the command line." />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Highlight nickname" IsCheckable="True" IsChecked="{Binding HighlightPolicy.HighlightNickname, Mode=TwoWay}" />
                <MenuItem Header="Highlight custom words" IsCheckable="True" IsChecked="{Binding HighlightPolicy.HighlightCustomWords, Mode=TwoWay}" />
                <Separator />
                <MenuItem Header="Preferences…" Click="OnPreferencesClick" />
                <MenuItem Header="Favorites and recents…" Click="OnFavoritesClick" />
                <MenuItem Header="Aliases and custom commands…" Click="OnAliasesClick" />
                <MenuItem Header="IRC history and search…" Click="OnLogsClick" />
            </MenuItem>
            <MenuItem Header="_Window">
                <MenuItem Header="_Next View" Command="{Binding NextViewCommand}" />
                <MenuItem Header="_Previous View" Command="{Binding PreviousViewCommand}" />
                <Separator />
                <MenuItem Header="Next conversation" Command="{Binding NextConversationCommand}" InputGestureText="Ctrl+Tab" />
                <MenuItem Header="Previous conversation" Command="{Binding PreviousConversationCommand}" InputGestureText="Ctrl+Shift+Tab" />
                <MenuItem Header="Next unread" Command="{Binding NextUnreadCommand}" InputGestureText="Ctrl+Alt+PageDown" />
                <MenuItem Header="Previous unread" Command="{Binding PreviousUnreadCommand}" InputGestureText="Ctrl+Alt+PageUp" />
                <MenuItem Header="Next highlight / priority" Command="{Binding NextHighlightCommand}" InputGestureText="Ctrl+Alt+Shift+PageDown" />
                <MenuItem Header="Previous highlight / priority" Command="{Binding PreviousHighlightCommand}" InputGestureText="Ctrl+Alt+Shift+PageUp" />
                <MenuItem Header="Conversation back" Command="{Binding BackConversationCommand}" InputGestureText="Alt+Left" />
                <MenuItem Header="Conversation forward" Command="{Binding ForwardConversationCommand}" InputGestureText="Alt+Right" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="About nexIRC" Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top" Visibility="{Binding IsToolbarVisible, Converter={StaticResource BooleanToVisibility}}">
            <ToolBar Background="#FFFFFF">
                <Button Content="Connect" Command="{Binding NewConnectionCommand}" Padding="10,3" />
                <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Padding="10,3" />
                <Button Content="Reconnect" Command="{Binding ReconnectCommand}" Padding="10,3" />
                <Separator />
                <Button Content="Join" Command="{Binding JoinCommand}" Padding="10,3" />
                <Button Content="Part" Command="{Binding PartCommand}" Padding="10,3" />
                <Button Content="Clear" Click="OnClearClick" Padding="10,3" />
                <Button Content="Query" Command="{Binding QueryCommand}" Padding="10,3" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom" Visibility="{Binding IsStatusBarVisible, Converter={StaticResource BooleanToVisibility}}">
            <StatusBarItem Content="{Binding StatusText}" AutomationProperties.AutomationId="StatusText" />
            <Separator />
            <StatusBarItem Content="{Binding Sessions.OperationFeedback.LatestText}" ToolTip="Latest server operation feedback" AutomationProperties.AutomationId="OperationFeedback" />
            <Separator />
            <StatusBarItem Content="nexIRC 5 · Phase 1V" />
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationColumn" Width="260" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0" Visibility="{Binding IsNetworkTreeVisible, Converter={StaticResource BooleanToVisibility}}">
                <DockPanel>
                    <Expander DockPanel.Dock="Bottom" Header="Conversation switcher" IsExpanded="True" MaxHeight="270" Margin="5,0,5,8">
                        <ListBox ItemsSource="{Binding ConversationNavigator}" BorderThickness="0" KeyboardNavigation.TabNavigation="Local">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.ActivateConversationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Padding="4,3" BorderThickness="0" Background="Transparent"
                                            ToolTip="{Binding AccessibleText}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding StateMarker, Mode=OneWay}" Width="20" />
                                            <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ActivityText}" Foreground="#64748B" Margin="8,0,0,0" />
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Expander>
                    <TextBlock DockPanel.Dock="Top" Text="NETWORKS &amp; WINDOWS" Style="{StaticResource PaneHeader}" />
                    <TreeView x:Name="WorkspaceTree" ItemsSource="{Binding Networks}" SelectedItemChanged="OnTreeSelectionChanged" Margin="5,0,5,8" />
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#CBD5E1" Visibility="{Binding IsNetworkTreeVisible, Converter={StaticResource BooleanToVisibility}}" />
            <Grid Grid.Column="2" Background="#F8FAFC">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <ContentControl Content="{Binding ActiveView}" ContentTemplateSelector="{StaticResource WorkspaceContentSelector}" />
                    <TextBlock Text="Add a connection to start using nexIRC" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#64748B" FontSize="16" Visibility="{Binding ActiveView, Converter={StaticResource NullToVisibility}}" />
                </Grid>
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="10,8">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Padding="8,5" Margin="0,0,0,6" Visibility="{Binding IsReplying, Converter={StaticResource BooleanToVisibility}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Cancel reply" Command="{Binding CancelReplyCommand}" Padding="8,2" AutomationProperties.AutomationId="Reply.Cancel" />
                                <TextBlock Text="{Binding ReplyBannerText}" VerticalAlignment="Center" Foreground="#1D4ED8" AutomationProperties.AutomationId="Reply.Banner" />
                            </DockPanel>
                        </Border>
                        <Button DockPanel.Dock="Right" Content="Send" Click="OnSendClick" Padding="18,5" Margin="8,0,0,0" IsDefault="True" />
                        <TextBox x:Name="InputBox" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" MinHeight="28" VerticalContentAlignment="Center" KeyDown="OnInputKeyDown" ToolTip="Type a message or /command" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
