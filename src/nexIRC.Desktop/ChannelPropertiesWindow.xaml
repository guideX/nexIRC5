<Window x:Class="nexIRC.Desktop.ChannelPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:nexIRC.Application;assembly=nexIRC.Application"
        Title="Channel Properties" Width="620" Height="620" MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="ChannelPropertiesWindow">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Foreground="#2563EB" TextWrapping="Wrap" AutomationProperties.AutomationId="ChannelProperties.OperationState" />
            <Button Content="Close" Width="90" HorizontalAlignment="Right" Margin="0,8,0,0" Click="OnCloseClick" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="General" FontSize="18" FontWeight="SemiBold" AutomationProperties.AutomationId="ChannelProperties.General" />
                <Grid Margin="0,8,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="Network" FontWeight="SemiBold" Margin="0,3" />
                    <TextBlock Grid.Column="1" Text="{Binding NetworkName}" Margin="0,3" />
                    <TextBlock Grid.Row="1" Text="Channel" FontWeight="SemiBold" Margin="0,3" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ChannelName}" Margin="0,3" AutomationProperties.AutomationId="ChannelProperties.Channel" />
                    <TextBlock Grid.Row="2" Text="Topic" FontWeight="SemiBold" Margin="0,3" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TopicText}" TextWrapping="Wrap" Margin="0,3" />
                    <TextBlock Grid.Row="3" Text="Topic metadata" FontWeight="SemiBold" Margin="0,3" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TopicSetterText}" Margin="0,3" />
                    <TextBlock Grid.Row="4" Text="Your apparent privilege" FontWeight="SemiBold" Margin="0,3" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ApparentPrivilegeText}" Margin="0,3" />
                    <TextBlock Grid.Row="5" Text="Mode authority" FontWeight="SemiBold" Margin="0,3" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding AuthorityText}" Margin="0,3" />
                    <TextBlock Grid.Row="6" Text="Creation time" FontWeight="SemiBold" Margin="0,3" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding CreationTimeText}" Margin="0,3" />
                </Grid>
                <TextBlock Text="Edit topic" FontSize="16" FontWeight="SemiBold" />
                <TextBox x:Name="TopicBox" Text="{Binding TopicDraft, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" Margin="0,6,0,4" AutomationProperties.AutomationId="ChannelProperties.TopicField" />
                <Button Content="Save topic" Width="110" HorizontalAlignment="Left" Click="OnSaveTopicClick" AutomationProperties.AutomationId="ChannelProperties.TopicEdit" />

                <TextBlock Text="Modes" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,6" AutomationProperties.AutomationId="ChannelProperties.Modes" />
                <ItemsControl ItemsSource="{Binding Modes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsActive, Mode=OneWay}" Click="OnModeClick" Tag="{Binding}" IsEnabled="{Binding IsEditable}" AutomationProperties.AutomationId="{Binding AutomationId}" />
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding ParameterText}" Foreground="#64748B" VerticalAlignment="Center" />
                                <Button Grid.Column="3" Content="Edit" Tag="{Binding}" Click="OnParameterClick" IsEnabled="{Binding IsEditable}" Visibility="{Binding IsParameterMode, Converter={StaticResource BooleanToVisibility}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Open Ban List" Width="120" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnBanListClick" AutomationProperties.AutomationId="ChannelProperties.BanList" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
